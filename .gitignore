# Original game files (copyrighted) - never commit
/samples/

# Generated output (exports, renders)
/out/

# Python environment and build artifacts
/.venv/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/

# Test and tooling caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Analysis databases and snapshots (may contain decompiled game code)
*.gpr
*.rep/
*.rea-snapshot

# Editor and OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Native accelerators built on demand from engine/native/*.c (docs/engine/simulation.md 7.5)
/engine/native/*.so
/engine/native/*.dylib
/engine/native/*.dll
/engine/native/*.tmp
